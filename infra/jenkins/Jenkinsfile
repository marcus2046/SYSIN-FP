pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'sysin-fp'
    }

    stages {
        stage('Quality Gate (Tests)') {
            steps {
                echo 'Running unit tests via Docker multi-stage build...'
                sh 'docker build --target test -t myapp/api:test ./api'
            }
        }

        stage('Build & Package') {
            steps {
                echo 'Building production container images...'
                sh 'docker compose build'
            }
        }

        stage('Deploy (Local Staging)') {
            steps {
                echo 'Deploying application stack...'
                sh 'docker compose up -d'
            }
        }

        stage('Integration / Health Check') {
            steps {
                echo 'Running automated health checks...'
                // Wait for Postgres and Node.js to initialize
                sh 'sleep 5'
                // Test if the application endpoint responds with HTTP 200
                sh 'docker compose exec -T proxy curl -f http://localhost:80/'
            }
        }
    }
}
    post {
        always {
            echo 'Pipeline execution complete.'
        }
        failure {
            echo 'Pipeline failed! Check logs above.'
        }
    }
}
